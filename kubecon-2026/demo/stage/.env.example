# Copy to .env and fill in the required values. Do not commit .env.
# Azure AI Foundry, OpenAI-compatible Responses API. Required.
# Base URL is the /openai/v1 root, without a /responses suffix.
LLM_BASE_URL=
LLM_API_KEY=
# Exact Foundry deployment name, not necessarily the model family name.
LLM_MODEL=

# Hindsight server: optional overrides. The intended provider is openai-responses;
# use openai only if the endpoint supports chat completions.
HINDSIGHT_API_LLM_PROVIDER=
# Set to none if the model rejects an explicit temperature.
HINDSIGHT_API_LLM_TEMPERATURE=
# Suggested API and control-plane ports: 8888 and 9999.
HINDSIGHT_PORT=
HINDSIGHT_CP_PORT=
# Suggested local embedded database directory: ./.hindsight-data.
HINDSIGHT_DATA_DIR=

# App: optional port override, suggested port 8000.
APP_PORT=
