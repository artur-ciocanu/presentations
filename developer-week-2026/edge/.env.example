# Azure OpenAI configuration for Edge Agent
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Anthropic on Azure AI Foundry for Edge Agent
ANTHROPIC_FOUNDRY_API_KEY=your-azure-foundry-api-key
ANTHROPIC_FOUNDRY_RESOURCE=your-foundry-resource-name

# Optional explicit endpoint override (takes precedence over resource)
EDGE_DEFAULT_AGENT_ID=edge-default-agent
EDGE_DEFAULT_AGENT_NAME=Edge Default Agent
EDGE_DEFAULT_AZURE_DEPLOYMENT=gpt-4o
